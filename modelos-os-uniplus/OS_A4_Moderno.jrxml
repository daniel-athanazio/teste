<parameter name="LOGO" class="java.lang.String" isForPrompting="false"><parameterDescription><![CDATA[Caminho do arquivo de logotipo (PNG/JPG)]]></parameterDescription><defaultValueExpression><![CDATA["C:/Uniplus/logo.png"]]></defaultValueExpression></parameter>
