# ---- Uniplus Web (deixe UNIPLUS_SERVIDOR vazio para rodar com dados de demonstracao)
UNIPLUS_SERVIDOR=
# Conta e chave da API (Ferramentas > Configuracao da API). NAO envie por chat.
# Se voce tem so o codigo de autorizacao ja pronto, deixe a conta vazia e ponha o codigo na chave.
UNIPLUS_CONTA=
UNIPLUS_AUTORIZACAO=
# status do Uniplus -> coluna do painel (ajustado pela aba Configuracao), ex.: 1=abertas,2=pendentes
STATUS_MAPA=
SYNC_MINUTOS=5

# ---- Painel
SENHA_PAINEL=troque-esta-senha
# senha master: libera valores (R$) e a aba Configuracao; definida na propria aba Configuracao
SENHA_DONO=
# chave para abrir o telao sem login:  https://SEU-DOMINIO/painel?tv=1&chave=...
CHAVE_TV=troque-esta-chave
SEGREDO=troque-por-um-texto-longo-aleatorio
URL_PUBLICA=https://os.fninfohouse.com.br
NOME_LOJA=FN Infohouse
WHATSAPP_LOJA=5521964382098

# ---- Help me! (acesso remoto): endereço do painel dos técnicos, para o botão "Acessar" nos chamados
HELPME_URL=https://suporte.fninfohouse.com.br

# ---- Regras
PRAZO_PADRAO_DIAS=5
PRAZO_VISITA_DIAS=2
META_MES=0
# prazos por etapa (dias) e aviso do prazo legal de 30 dias
PRAZO_ORCAMENTO_DIAS=2
PRAZO_TERCEIRIZADA_DIAS=15
PRAZO_RETIRADA_DIAS=180
ALERTA_LEGAL_DIAS=25
# terceirizada: amarelo a partir de X dias fora; vermelho a partir de PRAZO_TERCEIRIZADA_DIAS
TERC_AMARELO_DIAS=10
# campo extra do Uniplus que marca retorno em garantia (ex.: extra1); vazio = desligado
GARANTIA_CAMPO=
# lembretes automaticos pelo WhatsApp (0 ou vazio = desligado)
LEMBRETE_ORCAMENTO_DIAS=0
LEMBRETE_RETIRADA_DIAS=
# resumo diario para o responsavel (hora HH:MM e WhatsApp com 55 e DDD; vazio = desligado)
RESUMO_HORA=
RESUMO_TELEFONE=
# LGPD: apaga do painel nome/telefone/CPF das OS encerradas ha mais de N meses (0 = nunca)
RETENCAO_MESES=24
# periodo de OS exibidas no painel (aaaa-mm-dd; vazio = sem limite)
PERIODO_INI=
PERIODO_FIM=
# evento do Uniplus -> coluna do painel (ajustado pela aba Configuracao)
EVENTO_MAPA=
# chamados de suporte: fica vermelho se aberto sem atendimento ha mais de X minutos,
# ou aguardando o cliente ha mais de Y horas
ALERTA_CHAMADO_MIN=30
ALERTA_AGUARDANDO_HORAS=24

# ---- WhatsApp Cloud API (vazio = avisos desligados)
WA_TOKEN=
WA_PHONE_ID=
WA_IDIOMA=pt_BR
# nomes dos modelos aprovados na Meta (cada um com variaveis: {{1}} nome, {{2}} numero da OS, {{3}} link)
WA_MODELO_APROVACAO=os_aguardando_aprovacao
WA_MODELO_RETIRADA=os_pronta_retirada
WA_MODELO_FINALIZADA=os_finalizada_avaliacao
WA_MODELO_CHAMADO_ABERTO=chamado_aberto
WA_MODELO_CHAMADO_ATENDIMENTO=chamado_em_atendimento
WA_MODELO_CHAMADO_AGUARDANDO=chamado_aguardando_cliente
WA_MODELO_CHAMADO_CONCLUIDO=chamado_concluido_avaliacao
WA_MODELO_LEMBRETE_ORCAMENTO=os_lembrete_orcamento
WA_MODELO_LEMBRETE_RETIRADA=os_lembrete_retirada
WA_MODELO_RESUMO=resumo_diario
